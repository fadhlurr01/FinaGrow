}

model BankStatementImport {
  id                 String                    @id @default(uuid())
  organizationId     String                    @map("organization_id")
  entityId           String                    @map("entity_id")
  cashBankAccountId  String                    @map("cash_bank_account_id")
  sourceFilename     String                    @map("source_filename") @db.VarChar(255)
  statementStartDate DateTime?                 @map("statement_start_date") @db.Date
  statementEndDate   DateTime?                 @map("statement_end_date") @db.Date
  openingBalance     Decimal                   @default(0.0000) @map("opening_balance") @db.Decimal(18, 4)
  closingBalance     Decimal                   @default(0.0000) @map("closing_balance") @db.Decimal(18, 4)
  status             BankStatementImportStatus @default(IMPORTED)
  importedById       String?                   @map("imported_by_id")
  importedAt         DateTime                  @default(now()) @map("imported_at")
  createdAt          DateTime                  @default(now()) @map("created_at")
  updatedAt          DateTime                  @updatedAt @map("updated_at")

  organization       Organization              @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  entity             Entity                    @relation(fields: [entityId], references: [id], onDelete: Cascade)
  cashBankAccount    CashBankAccount           @relation(fields: [cashBankAccountId], references: [id], onDelete: Restrict)
  importedBy         User?                     @relation("ImportedByRelation", fields: [importedById], references: [id], onDelete: SetNull)
  lines              BankStatementLine[]

  @@index([organizationId])
  @@index([entityId])
  @@index([cashBankAccountId])
  @@index([statementStartDate])
  @@index([statementEndDate])
  @@map("bank_statement_imports")
}

model BankStatementLine {
  id                    String                   @id @default(uuid())
  bankStatementImportId String                   @map("bank_statement_import_id")
  transactionDate       DateTime                 @map("transaction_date") @db.Date
  valueDate             DateTime?                @map("value_date") @db.Date
  description           String                   @db.Text
  reference             String?                  @db.VarChar(255)
  debitAmount           Decimal                  @default(0.0000) @map("debit_amount") @db.Decimal(18, 4)
  creditAmount          Decimal                  @default(0.0000) @map("credit_amount") @db.Decimal(18, 4)
  amount                Decimal                  @default(0.0000) @db.Decimal(18, 4)
  balance               Decimal?                 @db.Decimal(18, 4)
  externalTransactionId String?                  @map("external_transaction_id") @db.VarChar(255)
  normalizedHash        String                   @map("normalized_hash") @db.VarChar(64)
  reconciliationStatus  StatementLineStatus      @default(UNMATCHED) @map("reconciliation_status")
  createdAt             DateTime                 @default(now()) @map("created_at")

  statementImport       BankStatementImport      @relation(fields: [bankStatementImportId], references: [id], onDelete: Cascade)
  matches               BankReconciliationMatch[]

  @@index([bankStatementImportId])
  @@index([transactionDate])
  @@index([externalTransactionId])
  @@index([normalizedHash])
  @@index([reconciliationStatus])
  @@map("bank_statement_lines")
}

model BankReconciliation {
  id                       String                   @id @default(uuid())
  organizationId           String                   @map("organization_id")
  entityId                 String                   @map("entity_id")
  cashBankAccountId        String                   @map("cash_bank_account_id")
  periodStart              DateTime                 @map("period_start") @db.Date
  periodEnd                DateTime                 @map("period_end") @db.Date
  statementOpeningBalance  Decimal                  @default(0.0000) @map("statement_opening_balance") @db.Decimal(18, 4)
  statementClosingBalance  Decimal                  @default(0.0000) @map("statement_closing_balance") @db.Decimal(18, 4)
  bookClosingBalance       Decimal                  @default(0.0000) @map("book_closing_balance") @db.Decimal(18, 4)
  difference               Decimal                  @default(0.0000) @db.Decimal(18, 4)
  status                   BankReconciliationStatus @default(IN_PROGRESS)
  completedById            String?                  @map("completed_by_id")
  completedAt              DateTime?                @map("completed_at")
  createdAt                DateTime                 @default(now()) @map("created_at")
  updatedAt                DateTime                 @updatedAt @map("updated_at")

  organization             Organization             @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  entity                   Entity                   @relation(fields: [entityId], references: [id], onDelete: Cascade)
  cashBankAccount          CashBankAccount          @relation(fields: [cashBankAccountId], references: [id], onDelete: Restrict)
  completedBy              User?                    @relation("CompletedByReconciliationRelation", fields: [completedById], references: [id], onDelete: SetNull)

  @@index([organizationId])
  @@index([entityId])
  @@index([cashBankAccountId])
  @@index([periodStart])
  @@index([periodEnd])
  @@index([status])
  @@map("bank_reconciliations")
}

model BankReconciliationMatch {
  id                  String            @id @default(uuid())
  bankStatementLineId String            @map("bank_statement_line_id")
  paymentId           String?           @map("payment_id")
  journalEntryId      String?           @map("journal_entry_id")
  matchedAmount       Decimal           @default(0.0000) @map("matched_amount") @db.Decimal(18, 4)
  confidence          Decimal           @default(1.0) @db.Decimal(4, 3)
  matchType           String            @default("MANUAL") @map("match_type") @db.VarChar(50)
  matchedById         String?           @map("matched_by_id")
  matchedAt           DateTime          @default(now()) @map("matched_at")
  createdAt           DateTime          @default(now()) @map("created_at")

  statementLine       BankStatementLine @relation(fields: [bankStatementLineId], references: [id], onDelete: Cascade)
  payment             Payment?          @relation(fields: [paymentId], references: [id], onDelete: SetNull)
  journalEntry        JournalEntry?     @relation(fields: [journalEntryId], references: [id], onDelete: SetNull)

  @@index([bankStatementLineId])
  @@index([paymentId])
  @@index([journalEntryId])
  @@map("bank_reconciliation_matches")
}

// --- PHASE 6 INVENTORY, VALUATION & COGS MODELS ---

model UnitOfMeasure {
  id             String          @id @default(uuid())
  organizationId String          @map("organization_id")
  code           String          @db.VarChar(50)
  name           String          @db.VarChar(100)
  precision      Int             @default(0)
  isActive       Boolean         @default(true) @map("is_active")
  createdAt      DateTime        @default(now()) @map("created_at")
  updatedAt      DateTime        @updatedAt @map("updated_at")

  organization   Organization    @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  items          InventoryItem[]

  @@unique([organizationId, code])
  @@index([organizationId])
  @@map("unit_of_measures")
}

model InventoryCategory {
  id             String              @id @default(uuid())
  organizationId String              @map("organization_id")
  entityId       String              @map("entity_id")
  code           String              @db.VarChar(50)
  name           String              @db.VarChar(255)
  description    String?             @db.Text
  parentId       String?             @map("parent_id")
  isActive       Boolean             @default(true) @map("is_active")
  createdAt      DateTime            @default(now()) @map("created_at")
  updatedAt      DateTime            @updatedAt @map("updated_at")

  organization   Organization        @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  entity         Entity              @relation(fields: [entityId], references: [id], onDelete: Cascade)
  parent         InventoryCategory?  @relation("CategoryHierarchy", fields: [parentId], references: [id], onDelete: Restrict)
  children       InventoryCategory[] @relation("CategoryHierarchy")
  items          InventoryItem[]

  @@unique([entityId, code])
  @@index([organizationId])
  @@index([entityId])
  @@map("inventory_categories")
}

model Warehouse {
  id             String            @id @default(uuid())
  organizationId String            @map("organization_id")
  entityId       String            @map("entity_id")
  code           String            @db.VarChar(50)
  name           String            @db.VarChar(255)
  address        String?           @db.Text
  isActive       Boolean           @default(true) @map("is_active")
  createdAt      DateTime          @default(now()) @map("created_at")
  updatedAt      DateTime          @updatedAt @map("updated_at")

  organization    Organization              @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  entity          Entity                    @relation(fields: [entityId], references: [id], onDelete: Cascade)
  locations       StockLocation[]
  movements       StockMovement[]
  valuationLayers InventoryValuationLayer[]
  goodsReceipts   GoodsReceipt[]
  deliveries      Delivery[]
  transfersFrom   StockTransfer[]           @relation("TransferFromWarehouse")
  transfersTo     StockTransfer[]           @relation("TransferToWarehouse")
  adjustments     StockAdjustment[]

  @@unique([entityId, code])
  @@index([organizationId])
  @@index([entityId])
  @@map("warehouses")
}

model StockLocation {
  id          String     @id @default(uuid())
  warehouseId String     @map("warehouse_id")
  code        String     @db.VarChar(50)
  name        String     @db.VarChar(100)
  isActive    Boolean    @default(true) @map("is_active")
  createdAt   DateTime   @default(now()) @map("created_at")

  warehouse   Warehouse  @relation(fields: [warehouseId], references: [id], onDelete: Cascade)

  @@unique([warehouseId, code])
  @@index([warehouseId])
  @@map("stock_locations")
}

model InventoryItem {
  id                   String            @id @default(uuid())
  organizationId       String            @map("organization_id")
  entityId             String            @map("entity_id")
  sku                  String            @db.VarChar(100)
  name                 String            @db.VarChar(255)
  description          String?           @db.Text
  categoryId           String?           @map("category_id")
  itemType             ItemType          @default(INVENTORY) @map("item_type")
  unitOfMeasureId      String?           @map("unit_of_measure_id")
  inventoryAccountId   String?           @map("inventory_account_id")
  cogsAccountId        String?           @map("cogs_account_id")
  salesAccountId       String?           @map("sales_account_id")
  purchaseAccountId    String?           @map("purchase_account_id")
  valuationMethod      ValuationMethod   @default(FIFO) @map("valuation_method")
  isInventoryTracked   Boolean           @default(true) @map("is_inventory_tracked")
  reorderLevel         Decimal           @default(0.0000) @map("reorder_level") @db.Decimal(12, 4)
  sellingPrice         Decimal           @default(0.0000) @map("selling_price") @db.Decimal(18, 4)
  purchasePrice        Decimal           @default(0.0000) @map("purchase_price") @db.Decimal(18, 4)
  isActive             Boolean           @default(true) @map("is_active")
  createdAt            DateTime          @default(now()) @map("created_at")
  updatedAt            DateTime          @updatedAt @map("updated_at")

  organization         Organization              @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  entity               Entity                    @relation(fields: [entityId], references: [id], onDelete: Cascade)
  category             InventoryCategory?        @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  unitOfMeasure        UnitOfMeasure?            @relation(fields: [unitOfMeasureId], references: [id], onDelete: SetNull)
  inventoryAccount     Account?                  @relation("ItemInventoryAccountRelation", fields: [inventoryAccountId], references: [id], onDelete: Restrict)
  cogsAccount          Account?                  @relation("ItemCOGSAccountRelation", fields: [cogsAccountId], references: [id], onDelete: Restrict)
  salesAccount         Account?                  @relation("ItemSalesAccountRelation", fields: [salesAccountId], references: [id], onDelete: Restrict)
  purchaseAccount      Account?                  @relation("ItemPurchaseAccountRelation", fields: [purchaseAccountId], references: [id], onDelete: Restrict)
  movements            StockMovement[]
  valuationLayers      InventoryValuationLayer[]
  goodsReceiptLines    GoodsReceiptLine[]
  deliveryLines        DeliveryLine[]
  purchaseOrderLines   PurchaseOrderLine[]
  vendorBillLines      VendorBillLine[]
  salesInvoiceLines    SalesInvoiceLine[]
  transferLines        StockTransferLine[]
  adjustmentLines      StockAdjustmentLine[]

  @@unique([entityId, sku])
  @@index([organizationId])
  @@index([entityId])
  @@index([sku])
  @@index([categoryId])
  @@index([isActive])
  @@map("inventory_items")
}

model StockMovement {
  id             String              @id @default(uuid())
  organizationId String              @map("organization_id")
  entityId       String              @map("entity_id")
  itemId         String              @map("item_id")
  warehouseId    String              @map("warehouse_id")
  movementNumber String              @map("movement_number") @db.VarChar(100)
  movementType   StockMovementType   @map("movement_type")
  movementDate   DateTime            @map("movement_date") @db.Date
  quantity       Decimal             @db.Decimal(12, 4)
  unitCost       Decimal             @default(0.0000) @map("unit_cost") @db.Decimal(18, 4)
  totalCost      Decimal             @default(0.0000) @map("total_cost") @db.Decimal(18, 4)
  sourceType     String?             @map("source_type") @db.VarChar(50)
  sourceId       String?             @map("source_id") @db.VarChar(100)
  reference      String?             @db.VarChar(255)
  status         StockMovementStatus @default(DRAFT)
  journalEntryId String?             @map("journal_entry_id")
  createdById    String?             @map("created_by_id")
  postedById     String?             @map("posted_by_id")
  postedAt       DateTime?           @map("posted_at")
  reversedAt     DateTime?           @map("reversed_at")
  createdAt      DateTime            @default(now()) @map("created_at")

  organization    Organization              @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  entity          Entity                    @relation(fields: [entityId], references: [id], onDelete: Cascade)
  item            InventoryItem             @relation(fields: [itemId], references: [id], onDelete: Restrict)
  warehouse       Warehouse                 @relation(fields: [warehouseId], references: [id], onDelete: Restrict)
  journalEntry    JournalEntry?             @relation(fields: [journalEntryId], references: [id], onDelete: SetNull)
  createdBy       User?                     @relation("CreatedByMovementRelation", fields: [createdById], references: [id], onDelete: SetNull)
  postedBy        User?                     @relation("PostedByMovementRelation", fields: [postedById], references: [id], onDelete: SetNull)
  valuationLayers InventoryValuationLayer[]

  @@unique([entityId, movementNumber])
  @@index([organizationId])
  @@index([entityId])
  @@index([itemId])
  @@index([warehouseId])
  @@index([movementDate])
  @@index([movementType])
  @@index([status])
  @@map("stock_movements")
}

model InventoryValuationLayer {
  id                String        @id @default(uuid())
  organizationId    String        @map("organization_id")
  entityId          String        @map("entity_id")
  itemId            String        @map("item_id")
  warehouseId       String        @map("warehouse_id")
  stockMovementId   String        @map("stock_movement_id")
  quantityIn        Decimal       @map("quantity_in") @db.Decimal(12, 4)
  quantityRemaining Decimal       @map("quantity_remaining") @db.Decimal(12, 4)
  unitCost          Decimal       @map("unit_cost") @db.Decimal(18, 4)
  totalCost         Decimal       @map("total_cost") @db.Decimal(18, 4)
  layerDate         DateTime      @map("layer_date") @db.Date
  createdAt         DateTime      @default(now()) @map("created_at")

  organization      Organization  @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  entity            Entity        @relation(fields: [entityId], references: [id], onDelete: Cascade)
  item              InventoryItem @relation(fields: [itemId], references: [id], onDelete: Restrict)
  warehouse         Warehouse     @relation(fields: [warehouseId], references: [id], onDelete: Restrict)
  stockMovement     StockMovement @relation(fields: [stockMovementId], references: [id], onDelete: Cascade)

  @@index([organizationId])
  @@index([entityId])
  @@index([itemId])
  @@index([warehouseId])
  @@index([layerDate])
  @@index([quantityRemaining])
  @@map("inventory_valuation_layers")
}

model GoodsReceipt {
  id              String             @id @default(uuid())
  organizationId  String             @map("organization_id")
  entityId        String             @map("entity_id")
  receiptNumber   String             @map("receipt_number") @db.VarChar(100)
  vendorId        String?            @map("vendor_id")
  purchaseOrderId String?            @map("purchase_order_id")
  warehouseId     String             @map("warehouse_id")
  receiptDate     DateTime           @map("receipt_date") @db.Date
  status          GoodsReceiptStatus @default(DRAFT)
  totalValue      Decimal            @default(0.0000) @map("total_value") @db.Decimal(18, 4)
  reference       String?            @db.VarChar(255)
  notes           String?            @db.Text
  journalEntryId  String?            @map("journal_entry_id")
  createdById     String?            @map("created_by_id")
  postedById      String?            @map("posted_by_id")
  postedAt        DateTime?          @map("posted_at")
  createdAt       DateTime           @default(now()) @map("created_at")
  updatedAt       DateTime           @updatedAt @map("updated_at")

  organization    Organization       @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  entity          Entity             @relation(fields: [entityId], references: [id], onDelete: Cascade)
  vendor          Vendor?            @relation(fields: [vendorId], references: [id], onDelete: SetNull)
  purchaseOrder   PurchaseOrder?     @relation(fields: [purchaseOrderId], references: [id], onDelete: SetNull)
  warehouse       Warehouse          @relation(fields: [warehouseId], references: [id], onDelete: Restrict)
  journalEntry    JournalEntry?      @relation(fields: [journalEntryId], references: [id], onDelete: SetNull)
  createdBy       User?              @relation("CreatedByReceiptRelation", fields: [createdById], references: [id], onDelete: SetNull)
  postedBy        User?              @relation("PostedByReceiptRelation", fields: [postedById], references: [id], onDelete: SetNull)
  lines           GoodsReceiptLine[]

  @@unique([entityId, receiptNumber])
  @@index([organizationId])
  @@index([entityId])
  @@index([purchaseOrderId])
  @@index([warehouseId])
  @@index([receiptDate])
  @@index([status])
  @@map("goods_receipts")
}

model GoodsReceiptLine {
  id                  String             @id @default(uuid())
  goodsReceiptId      String             @map("goods_receipt_id")
  itemId              String             @map("item_id")
  purchaseOrderLineId String?            @map("purchase_order_line_id")
  quantityReceived    Decimal            @map("quantity_received") @db.Decimal(12, 4)
  unitCost            Decimal            @map("unit_cost") @db.Decimal(18, 4)
  totalCost           Decimal            @map("total_cost") @db.Decimal(18, 4)
  createdAt           DateTime           @default(now()) @map("created_at")

  goodsReceipt        GoodsReceipt       @relation(fields: [goodsReceiptId], references: [id], onDelete: Cascade)
  item                InventoryItem      @relation(fields: [itemId], references: [id], onDelete: Restrict)
  purchaseOrderLine   PurchaseOrderLine? @relation(fields: [purchaseOrderLineId], references: [id], onDelete: SetNull)
  vendorBillLines     VendorBillLine[]

  @@index([goodsReceiptId])
  @@index([itemId])
  @@index([purchaseOrderLineId])
  @@map("goods_receipt_lines")
}

model Delivery {
