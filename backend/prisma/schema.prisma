model CashBankAccount {
  id                String              @id @default(uuid())
  organizationId    String              @map("organization_id")
  entityId          String              @map("entity_id")
  code              String              @db.VarChar(50)
  name              String              @db.VarChar(255)
  type              CashBankAccountType @default(BANK)
  coaAccountId      String              @map("coa_account_id")
  currency          String              @default("IDR") @db.VarChar(10)
  bankName          String?             @map("bank_name") @db.VarChar(100)
  bankAccountNumber String?             @map("bank_account_number") @db.VarChar(100)
  bankAccountHolder String?             @map("bank_account_holder") @db.VarChar(255)
  branch            String?             @db.VarChar(100)
  swiftCode         String?             @map("swift_code") @db.VarChar(50)
  openingBalance    Decimal             @default(0.0000) @map("opening_balance") @db.Decimal(18, 4)
  isActive          Boolean             @default(true) @map("is_active")
  createdAt         DateTime            @default(now()) @map("created_at")
  updatedAt         DateTime            @updatedAt @map("updated_at")

  organization      Organization        @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  entity            Entity              @relation(fields: [entityId], references: [id], onDelete: Cascade)
  coaAccount        Account             @relation("CashBankAccountCOARelation", fields: [coaAccountId], references: [id], onDelete: Restrict)
  payments          Payment[]           @relation("PaymentCashBankAccountRelation")
  transfersTo       Payment[]           @relation("TransferToCashBankAccountRelation")
  statementImports  BankStatementImport[]
  reconciliations   BankReconciliation[]
  assetDisposals    AssetDisposal[]
  taxPayments       TaxPayment[]

  @@unique([entityId, code])
  @@index([organizationId])
  @@index([entityId])
  @@index([coaAccountId])
  @@index([isActive])
  @@map("cash_bank_accounts")
}

