model AssetImpairment {
  id             String        @id @default(uuid())
  assetId        String        @map("asset_id")
  impairmentDate DateTime      @map("impairment_date") @db.Date
  amount         Decimal       @db.Decimal(18, 4)
  reason         String        @db.Text
  journalEntryId String?       @map("journal_entry_id")
  createdAt      DateTime      @default(now()) @map("created_at")

  asset          FixedAsset    @relation(fields: [assetId], references: [id], onDelete: Cascade)
  journalEntry   JournalEntry? @relation(fields: [journalEntryId], references: [id], onDelete: SetNull)

  @@index([assetId])
  @@index([impairmentDate])
  @@map("asset_impairments")
}

// ===========================================================
// --- PHASE 8: INDONESIAN TAX ENGINE MODELS ---
// ===========================================================

model TaxCode {
  id             String       @id @default(uuid())
  organizationId String       @map("organization_id")
  // entityId null = org-level shared code; non-null = entity-scoped override
  entityId       String?      @map("entity_id")
  code           String       @db.VarChar(100)
  name           String       @db.VarChar(255)
  taxType        TaxType      @map("tax_type")
  direction      TaxDirection
  description    String?      @db.Text
  isActive       Boolean      @default(true) @map("is_active")
  createdAt      DateTime     @default(now()) @map("created_at")
  updatedAt      DateTime     @updatedAt @map("updated_at")

  organization               Organization        @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  rules                      TaxRule[]
  salesInvoiceLines          SalesInvoiceLine[]  @relation("SalesLineTaxCodeRelation")
  vendorBillLines            VendorBillLine[]    @relation("BillLineTaxCodeRelation")
  taxTransactions            TaxTransaction[]
  taxDocuments               TaxDocument[]
  payments                   Payment[]           @relation("PaymentWithholdingTaxCodeRelation")
  customerDefaultSalesCodes  Customer[]          @relation("CustomerDefaultSalesTaxCodeRelation")
  customerDefaultWithholdingCodes Customer[]     @relation("CustomerDefaultWithholdingTaxCodeRelation")
  vendorDefaultPurchaseCodes Vendor[]            @relation("VendorDefaultPurchaseTaxCodeRelation")
  vendorDefaultWithholdingCodes Vendor[]         @relation("VendorDefaultWithholdingTaxCodeRelation")

  @@unique([organizationId, code])
  @@index([organizationId])
  @@index([entityId])
  @@index([taxType])
  @@index([direction])
  @@index([isActive])
  @@map("tax_codes")
}

model TaxRule {
  id                    String               @id @default(uuid())
  taxCodeId             String               @map("tax_code_id")
  validFrom             DateTime             @map("valid_from") @db.Date
  validTo               DateTime?            @map("valid_to") @db.Date
  legalRate             Decimal              @map("legal_rate") @db.Decimal(8, 6)
  // DPP factor for RATE_TIMES_DPP_FACTOR method: e.g. 11/12 for standard Indonesian VAT
  dppFactor             Decimal              @default(1.0) @map("dpp_factor") @db.Decimal(8, 6)
  calculationMethod     TaxCalculationMethod @default(PERCENT_OF_BASE) @map("calculation_method")
  roundingMethod        TaxRoundingMethod    @default(ROUND_HALF_UP) @map("rounding_method")
  notes                 String?              @db.Text
  isActive              Boolean              @default(true) @map("is_active")
  createdAt             DateTime             @default(now()) @map("created_at")
  updatedAt             DateTime             @updatedAt @map("updated_at")

  taxCode               TaxCode              @relation(fields: [taxCodeId], references: [id], onDelete: Cascade)
  taxTransactions       TaxTransaction[]

  @@index([taxCodeId])
  @@index([validFrom])
  @@index([validTo])
  @@index([isActive])
  @@map("tax_rules")
}

model TaxTransaction {
  id                String               @id @default(uuid())
  organizationId    String               @map("organization_id")
  entityId          String               @map("entity_id")
  taxCodeId         String               @map("tax_code_id")
  taxRuleId         String               @map("tax_rule_id")
  taxPeriodId       String?              @map("tax_period_id")
  // Source document link — exactly one non-null
  sourceType        TaxSourceType        @map("source_type")
  salesInvoiceId    String?              @map("sales_invoice_id")
  vendorBillId      String?              @map("vendor_bill_id")
  paymentId         String?              @map("payment_id")
  // Amounts (Decimal, immutable after POSTED)
  transactionDate   DateTime             @map("transaction_date") @db.Date
  baseAmount        Decimal              @map("base_amount") @db.Decimal(18, 4)
  dppAmount         Decimal              @map("dpp_amount") @db.Decimal(18, 4)
  taxAmount         Decimal              @map("tax_amount") @db.Decimal(18, 4)
  legalRate         Decimal              @map("legal_rate") @db.Decimal(8, 6)
  dppFactor         Decimal              @default(1.0) @map("dpp_factor") @db.Decimal(8, 6)
  direction         TaxDirection
  status            TaxTransactionStatus @default(DRAFT)
  // GL linkage
  journalEntryId    String?              @map("journal_entry_id")
  // reversedById is retained for audit trail only; reversal link is via reversalOfId
  reversedById      String?              @map("reversed_by_id")
  reversalOfId      String?              @map("reversal_of_id")
  notes             String?              @db.Text
  createdAt         DateTime             @default(now()) @map("created_at")
  updatedAt         DateTime             @updatedAt @map("updated_at")

  organization      Organization         @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  entity            Entity               @relation(fields: [entityId], references: [id], onDelete: Cascade)
  taxCode           TaxCode              @relation(fields: [taxCodeId], references: [id], onDelete: Restrict)
  taxRule           TaxRule              @relation(fields: [taxRuleId], references: [id], onDelete: Restrict)
  taxPeriod         TaxPeriod?           @relation(fields: [taxPeriodId], references: [id], onDelete: SetNull)
  journalEntry      JournalEntry?        @relation(fields: [journalEntryId], references: [id], onDelete: SetNull)
  payment           Payment?             @relation(fields: [paymentId], references: [id], onDelete: SetNull)
  // One-to-many reversal chain: a transaction may be reversed by at most one other transaction
  reversedBy        TaxTransaction[]     @relation("TaxReversalRelation")
  reversalOf        TaxTransaction?      @relation("TaxReversalRelation", fields: [reversalOfId], references: [id], onDelete: SetNull)
  withholdingEvidence WithholdingEvidence?
  taxDocuments      TaxDocument[]

  @@index([organizationId])
  @@index([entityId])
  @@index([taxCodeId])
  @@index([taxPeriodId])
  @@index([salesInvoiceId])
  @@index([vendorBillId])
  @@index([paymentId])
  @@index([transactionDate])
  @@index([direction])
  @@index([status])
  @@map("tax_transactions")
}

model TaxPeriod {
  id                  String          @id @default(uuid())
  organizationId      String          @map("organization_id")
  entityId            String          @map("entity_id")
  taxType             TaxType         @map("tax_type")
  periodYear          Int             @map("period_year")
  periodMonth         Int             @map("period_month")
  status              TaxPeriodStatus @default(OPEN)
  // Computed totals (populated on PREPARE)
  totalOutputTax      Decimal         @default(0.0000) @map("total_output_tax") @db.Decimal(18, 4)
  totalInputTax       Decimal         @default(0.0000) @map("total_input_tax") @db.Decimal(18, 4)
  totalWithholdingPayable   Decimal   @default(0.0000) @map("total_withholding_payable") @db.Decimal(18, 4)
  totalWithholdingReceivable Decimal  @default(0.0000) @map("total_withholding_receivable") @db.Decimal(18, 4)
  netTax              Decimal         @default(0.0000) @map("net_tax") @db.Decimal(18, 4)
  totalPaid           Decimal         @default(0.0000) @map("total_paid") @db.Decimal(18, 4)
  filingDeadline      DateTime?       @map("filing_deadline") @db.Date
  filedAt             DateTime?       @map("filed_at")
  filedById           String?         @map("filed_by_id")
  notes               String?         @db.Text
  createdAt           DateTime        @default(now()) @map("created_at")
  updatedAt           DateTime        @updatedAt @map("updated_at")

  organization        Organization    @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  entity              Entity          @relation(fields: [entityId], references: [id], onDelete: Cascade)
  filedBy             User?           @relation("FiledByTaxPeriodRelation", fields: [filedById], references: [id], onDelete: SetNull)
  taxTransactions     TaxTransaction[]
  taxDocuments        TaxDocument[]
  taxPayments         TaxPayment[]

  @@unique([entityId, taxType, periodYear, periodMonth])
  @@index([organizationId])
  @@index([entityId])
  @@index([taxType])
  @@index([periodYear, periodMonth])
  @@index([status])
  @@map("tax_periods")
}

model TaxDocument {
  id                String            @id @default(uuid())
  organizationId    String            @map("organization_id")
  entityId          String            @map("entity_id")
  taxPeriodId       String?           @map("tax_period_id")
  taxCodeId         String?           @map("tax_code_id")
  taxTransactionId  String?           @map("tax_transaction_id")
  documentType      TaxDocumentType   @map("document_type")
  documentNumber    String?           @map("document_number") @db.VarChar(100)
  issueDate         DateTime?         @map("issue_date") @db.Date
  counterpartyName  String?           @map("counterparty_name") @db.VarChar(255)
  counterpartyNpwp  String?           @map("counterparty_npwp") @db.VarChar(30)
  taxableBase       Decimal           @default(0.0000) @map("taxable_base") @db.Decimal(18, 4)
  taxAmount         Decimal           @default(0.0000) @map("tax_amount") @db.Decimal(18, 4)
  status            TaxDocumentStatus @default(DRAFT)
  replacedById      String?           @map("replaced_by_id")
  notes             String?           @db.Text
  createdAt         DateTime          @default(now()) @map("created_at")
  updatedAt         DateTime          @updatedAt @map("updated_at")

  organization      Organization      @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  entity            Entity            @relation(fields: [entityId], references: [id], onDelete: Cascade)
  taxPeriod         TaxPeriod?        @relation(fields: [taxPeriodId], references: [id], onDelete: SetNull)
  taxCode           TaxCode?          @relation(fields: [taxCodeId], references: [id], onDelete: SetNull)
  taxTransaction    TaxTransaction?   @relation(fields: [taxTransactionId], references: [id], onDelete: SetNull)
  // One-to-many replacement chain
  replacedBy        TaxDocument?      @relation("TaxDocumentReplacementRelation", fields: [replacedById], references: [id], onDelete: SetNull)
  replaces          TaxDocument[]     @relation("TaxDocumentReplacementRelation")

  @@index([organizationId])
  @@index([entityId])
  @@index([taxPeriodId])
  @@index([taxCodeId])
  @@index([taxTransactionId])
  @@index([documentType])
  @@index([status])
  @@map("tax_documents")
}

model TaxPayment {
  id               String           @id @default(uuid())
  organizationId   String           @map("organization_id")
  entityId         String           @map("entity_id")
  taxPeriodId      String           @map("tax_period_id")
  paymentNumber    String           @map("payment_number") @db.VarChar(100)
  paymentDate      DateTime         @map("payment_date") @db.Date
  taxType          TaxType          @map("tax_type")
  amount           Decimal          @default(0.0000) @db.Decimal(18, 4)
  // Government bank account details
  ntpn             String?          @db.VarChar(50)
  sspNumber        String?          @map("ssp_number") @db.VarChar(50)
  cashBankAccountId String          @map("cash_bank_account_id")
  journalEntryId   String?          @map("journal_entry_id")
  status           TaxPaymentStatus @default(DRAFT)
  notes            String?          @db.Text
  createdById      String?          @map("created_by_id")
  postedById       String?          @map("posted_by_id")
  postedAt         DateTime?        @map("posted_at")
  createdAt        DateTime         @default(now()) @map("created_at")
  updatedAt        DateTime         @updatedAt @map("updated_at")

  organization     Organization     @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  entity           Entity           @relation(fields: [entityId], references: [id], onDelete: Cascade)
  taxPeriod        TaxPeriod        @relation(fields: [taxPeriodId], references: [id], onDelete: Restrict)
  cashBankAccount  CashBankAccount  @relation(fields: [cashBankAccountId], references: [id], onDelete: Restrict)
  journalEntry     JournalEntry?    @relation(fields: [journalEntryId], references: [id], onDelete: SetNull)
  createdBy        User?            @relation("CreatedByTaxPaymentRelation", fields: [createdById], references: [id], onDelete: SetNull)
  postedBy         User?            @relation("PostedByTaxPaymentRelation", fields: [postedById], references: [id], onDelete: SetNull)

  @@unique([entityId, paymentNumber])
  @@index([organizationId])
  @@index([entityId])
  @@index([taxPeriodId])
  @@index([taxType])
  @@index([status])
  @@map("tax_payments")
}

model WithholdingEvidence {
  id                   String                    @id @default(uuid())
  taxTransactionId     String                    @unique @map("tax_transaction_id")
  certificateNumber    String?                   @map("certificate_number") @db.VarChar(100)
  issueDate            DateTime?                 @map("issue_date") @db.Date
  counterpartyName     String?                   @map("counterparty_name") @db.VarChar(255)
  counterpartyNpwp     String?                   @map("counterparty_npwp") @db.VarChar(30)
  status               WithholdingEvidenceStatus @default(PENDING_DOCUMENT)
  documentUrl          String?                   @map("document_url") @db.Text
  receivedAt           DateTime?                 @map("received_at")
  createdAt            DateTime                  @default(now()) @map("created_at")
  updatedAt            DateTime                  @updatedAt @map("updated_at")

  taxTransaction       TaxTransaction            @relation(fields: [taxTransactionId], references: [id], onDelete: Cascade)

  @@index([taxTransactionId])
  @@index([status])
  @@map("withholding_evidences")
}

model TaxAdjustment {
  id               String       @id @default(uuid())
  organizationId   String       @map("organization_id")
  entityId         String       @map("entity_id")
  taxPeriodId      String?      @map("tax_period_id")
  adjustmentDate   DateTime     @map("adjustment_date") @db.Date
  taxType          TaxType      @map("tax_type")
  direction        TaxDirection
  amount           Decimal      @db.Decimal(18, 4)
  reason           String       @db.Text
  journalEntryId   String?      @map("journal_entry_id")
  createdAt        DateTime     @default(now()) @map("created_at")

  @@index([organizationId])
  @@index([entityId])
  @@index([taxPeriodId])
  @@index([adjustmentDate])
  @@map("tax_adjustments")
}

// ===================================================================
// Phase 9 — Budgeting, Projects, Payroll, Subscription & Settings
// ===================================================================

model Budget {
  id             String       @id @default(uuid())
  organizationId String       @map("organization_id")
  entityId       String       @map("entity_id")
  accountId      String       @map("account_id")
  period         String       @db.VarChar(20) // e.g. "2024-07", "2026-08"
  amount         Decimal      @db.Decimal(18, 4)
  notes          String?      @db.Text
  createdById    String?      @map("created_by_id")
  createdAt      DateTime     @default(now()) @map("created_at")
  updatedAt      DateTime     @updatedAt @map("updated_at")

  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  entity         Entity       @relation(fields: [entityId], references: [id], onDelete: Cascade)
  account        Account      @relation(fields: [accountId], references: [id], onDelete: Restrict)
  createdBy      User?        @relation("CreatedByBudgetRelation", fields: [createdById], references: [id], onDelete: SetNull)

  @@unique([entityId, accountId, period])
  @@index([organizationId])
  @@index([entityId])
  @@index([period])
  @@map("budgets")
}

model Project {
  id             String       @id @default(uuid())
  organizationId String       @map("organization_id")
  entityId       String       @map("entity_id")
  code           String?      @db.VarChar(50)
  name           String       @db.VarChar(255)
  customer       String?      @db.VarChar(255)
  budget         Decimal      @default(0) @db.Decimal(18, 4)
  spent          Decimal      @default(0) @db.Decimal(18, 4)
  progress       Decimal      @default(0) @db.Decimal(5, 2)
  status         String       @default("In Progress") @db.VarChar(50)
  profitability  Decimal      @default(0) @db.Decimal(5, 2)
  startDate      DateTime?    @map("start_date") @db.Date
  endDate        DateTime?    @map("end_date") @db.Date
  description    String?      @db.Text
  createdById    String?      @map("created_by_id")
  createdAt      DateTime     @default(now()) @map("created_at")
  updatedAt      DateTime     @updatedAt @map("updated_at")

  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  entity         Entity       @relation(fields: [entityId], references: [id], onDelete: Cascade)
  createdBy      User?        @relation("CreatedByProjectRelation", fields: [createdById], references: [id], onDelete: SetNull)

  @@index([organizationId])
  @@index([entityId])
  @@index([status])
  @@map("projects")
}

model PayrollEmployee {
  id             String       @id @default(uuid())
  organizationId String       @map("organization_id")
  entityId       String       @map("entity_id")
  employeeCode   String       @map("employee_code") @db.VarChar(50)
  name           String       @db.VarChar(255)
  position       String       @db.VarChar(100)
  baseSalary     Decimal      @map("base_salary") @db.Decimal(18, 4)
  allowances     Decimal      @default(0) @db.Decimal(18, 4)
  deductions     Decimal      @default(0) @db.Decimal(18, 4)
  isActive       Boolean      @default(true) @map("is_active")
  createdAt      DateTime     @default(now()) @map("created_at")
  updatedAt      DateTime     @updatedAt @map("updated_at")

  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  entity         Entity       @relation(fields: [entityId], references: [id], onDelete: Cascade)

  @@unique([entityId, employeeCode])
  @@index([organizationId])
  @@index([entityId])
  @@map("payroll_employees")
}

model PayrollRun {
  id             String       @id @default(uuid())
  organizationId String       @map("organization_id")
  entityId       String       @map("entity_id")
  payPeriod      String       @map("pay_period") @db.VarChar(50) // e.g. "July 2024", "2026-08"
  runDate        DateTime     @map("run_date") @db.Date
  totalGross     Decimal      @map("total_gross") @db.Decimal(18, 4)
  totalTaxes     Decimal      @map("total_taxes") @db.Decimal(18, 4)
  totalNet       Decimal      @map("total_net") @db.Decimal(18, 4)
  status         String       @default("Completed") @db.VarChar(50) // "Scheduled", "In Progress", "Completed", "Cancelled"
  employeeCount  Int          @default(0) @map("employee_count")
  notes          String?      @db.Text
  createdById    String?      @map("created_by_id")
  createdAt      DateTime     @default(now()) @map("created_at")
  updatedAt      DateTime     @updatedAt @map("updated_at")

  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  entity         Entity       @relation(fields: [entityId], references: [id], onDelete: Cascade)
  createdBy      User?        @relation("CreatedByPayrollRunRelation", fields: [createdById], references: [id], onDelete: SetNull)

  @@index([organizationId])
  @@index([entityId])
  @@index([payPeriod])
  @@map("payroll_runs")
}

model Subscription {
  id             String       @id @default(uuid())
  organizationId String       @unique @map("organization_id")
  planCode       String       @default("PRO") @map("plan_code") @db.VarChar(50) // "FREE", "STARTER", "PRO", "ENTERPRISE"
  status         String       @default("ACTIVE") @db.VarChar(50) // "ACTIVE", "TRIAL", "EXPIRED", "CANCELLED"
  startDate      DateTime     @default(now()) @map("start_date")
  endDate        DateTime?    @map("end_date")
  autoRenew      Boolean      @default(true) @map("auto_renew")
  createdAt      DateTime     @default(now()) @map("created_at")
  updatedAt      DateTime     @updatedAt @map("updated_at")

  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId])
  @@map("subscriptions")
}

model UserSettings {
  id             String       @id @default(uuid())
  userId         String       @unique @map("user_id")
  language       String       @default("id") @db.VarChar(10)
  theme          String       @default("light") @db.VarChar(20)
  timezone       String       @default("Asia/Jakarta") @db.VarChar(100)
  enabledModules Json?        @map("enabled_modules")
  createdAt      DateTime     @default(now()) @map("created_at")
  updatedAt      DateTime     @updatedAt @map("updated_at")

  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("user_settings")
}
