  organization          Organization        @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  entity                Entity              @relation(fields: [entityId], references: [id], onDelete: Cascade)
  customer              Customer?           @relation(fields: [customerId], references: [id], onDelete: Restrict)
  vendor                Vendor?             @relation(fields: [vendorId], references: [id], onDelete: Restrict)
  cashBankAccount       CashBankAccount     @relation("PaymentCashBankAccountRelation", fields: [cashBankAccountId], references: [id], onDelete: Restrict)
  toCashBankAccount     CashBankAccount?    @relation("TransferToCashBankAccountRelation", fields: [toCashBankAccountId], references: [id], onDelete: Restrict)
  withholdingTaxCode    TaxCode?            @relation("PaymentWithholdingTaxCodeRelation", fields: [withholdingTaxCodeId], references: [id], onDelete: SetNull)
  journalEntry          JournalEntry?       @relation(fields: [journalEntryId], references: [id], onDelete: SetNull)
  createdBy             User?               @relation("CreatedByPaymentRelation", fields: [createdById], references: [id], onDelete: SetNull)
