model StockAdjustment {
  id               String                @id @default(uuid())
  organizationId   String                @map("organization_id")
  entityId         String                @map("entity_id")
  adjustmentNumber String                @map("adjustment_number") @db.VarChar(100)
  warehouseId      String                @map("warehouse_id")
  adjustmentDate   DateTime              @map("adjustment_date") @db.Date
  adjustmentType   StockAdjustmentType   @map("adjustment_type")
  status           StockAdjustmentStatus @default(DRAFT)
  totalCost        Decimal               @default(0.0000) @map("total_cost") @db.Decimal(18, 4)
  reason           String                @db.Text
  reference        String?               @db.VarChar(255)
  journalEntryId   String?               @map("journal_entry_id")
  createdById      String?               @map("created_by_id")
  postedById       String?               @map("posted_by_id")
  postedAt         DateTime?             @map("posted_at")
  createdAt        DateTime              @default(now()) @map("created_at")
  updatedAt        DateTime              @updatedAt @map("updated_at")

  organization     Organization          @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  entity           Entity                @relation(fields: [entityId], references: [id], onDelete: Cascade)
  warehouse        Warehouse             @relation(fields: [warehouseId], references: [id], onDelete: Restrict)
  journalEntry     JournalEntry?         @relation(fields: [journalEntryId], references: [id], onDelete: SetNull)
  createdBy        User?                 @relation("CreatedByAdjustmentRelation", fields: [createdById], references: [id], onDelete: SetNull)
  postedBy         User?                 @relation("PostedByAdjustmentRelation", fields: [postedById], references: [id], onDelete: SetNull)
  lines            StockAdjustmentLine[]

  @@unique([entityId, adjustmentNumber])
  @@index([organizationId])
  @@index([entityId])
  @@index([warehouseId])
  @@index([adjustmentDate])
  @@index([status])
  @@map("stock_adjustments")
}

model StockAdjustmentLine {
  id                String          @id @default(uuid())
  stockAdjustmentId String          @map("stock_adjustment_id")
  itemId            String          @map("item_id")
  quantity          Decimal         @db.Decimal(12, 4)
  unitCost          Decimal         @default(0.0000) @map("unit_cost") @db.Decimal(18, 4)
  totalCost         Decimal         @default(0.0000) @map("total_cost") @db.Decimal(18, 4)
  createdAt         DateTime        @default(now()) @map("created_at")

  stockAdjustment   StockAdjustment @relation(fields: [stockAdjustmentId], references: [id], onDelete: Cascade)
