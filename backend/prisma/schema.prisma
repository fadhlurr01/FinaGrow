datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

enum Role {
  OWNER
  ADMIN
  ACCOUNTANT
  AUDITOR
  VIEWER
}

enum AccountType {
  ASSET
  LIABILITY
  EQUITY
  REVENUE
  EXPENSE
}

enum AccountSubtype {
  // Asset subtypes
  CURRENT_ASSET
  NON_CURRENT_ASSET
  CASH_AND_EQUIVALENT
  ACCOUNTS_RECEIVABLE
  INVENTORY
  PREPAID_EXPENSE
  FIXED_ASSET
  ACCUMULATED_DEPRECIATION
  OTHER_ASSET

  // Liability subtypes
  CURRENT_LIABILITY
  NON_CURRENT_LIABILITY
  ACCOUNTS_PAYABLE
  TAX_PAYABLE
  ACCRUED_EXPENSE
  OTHER_LIABILITY

  // Equity subtypes
  EQUITY
  RETAINED_EARNINGS

  // Revenue subtypes
  OPERATING_REVENUE
  NON_OPERATING_REVENUE

  // Expense subtypes
  COST_OF_GOODS_SOLD
  OPERATING_EXPENSE
  PAYROLL_EXPENSE
  DEPRECIATION_EXPENSE
  TAX_EXPENSE
  NON_OPERATING_EXPENSE
  OTHER_EXPENSE
}

enum NormalBalance {
  DEBIT
  CREDIT
}

enum JournalEntryStatus {
  DRAFT
  POSTED
  VOIDED
}

enum SalesInvoiceStatus {
  DRAFT
  SENT
  PARTIALLY_PAID
  PAID
  OVERDUE
  CANCELLED
}

enum InvoicePostingStatus {
  UNPOSTED
  POSTED
  REVERSED
}

enum PurchaseOrderStatus {
  DRAFT
  APPROVED
  PARTIALLY_BILLED
  FULLY_BILLED
  CANCELLED
}

enum VendorBillStatus {
  DRAFT
  OPEN
  PARTIALLY_PAID
  PAID
  OVERDUE
  CANCELLED
}

enum BillLineType {
  EXPENSE
  INVENTORY
  ASSET
  SERVICE
  OTHER
}

enum CashBankAccountType {
  CASH
  BANK
  E_WALLET
  OTHER
}

enum PaymentType {
  CUSTOMER_RECEIPT
  VENDOR_PAYMENT
  TRANSFER
  OTHER_RECEIPT
  OTHER_PAYMENT
}

enum PaymentDirection {
  INBOUND
  OUTBOUND
  INTERNAL
}

enum PaymentStatus {
  DRAFT
  POSTED
  REVERSED
  CANCELLED
}

enum BankStatementImportStatus {
  IMPORTED
  RECONCILED
  CANCELLED
}

enum StatementLineStatus {
  UNMATCHED
  MATCHED
  PARTIALLY_MATCHED
  IGNORED
  RECONCILED
}

enum BankReconciliationStatus {
  IN_PROGRESS
  RECONCILED
  REOPENED
}

// --- PHASE 6 INVENTORY & VALUATION ENUMS ---

enum ItemType {
  INVENTORY
  SERVICE
  NON_INVENTORY
}

enum ValuationMethod {
  FIFO
  WEIGHTED_AVERAGE
}

enum StockMovementType {
  OPENING
  PURCHASE_RECEIPT
  SALES_ISSUE
  TRANSFER_IN
  TRANSFER_OUT
  ADJUSTMENT_IN
  ADJUSTMENT_OUT
  RETURN_IN
  RETURN_OUT
}

enum StockMovementStatus {
  DRAFT
  POSTED
  REVERSED
}

enum GoodsReceiptStatus {
  DRAFT
  POSTED
  REVERSED
  CANCELLED
}

enum DeliveryStatus {
  DRAFT
  POSTED
  REVERSED
  CANCELLED
}

enum StockAdjustmentType {
  INCREASE
  DECREASE
}

enum StockAdjustmentStatus {
  DRAFT
  POSTED
  REVERSED
}

enum StockTransferStatus {
  DRAFT
  POSTED
  REVERSED
  CANCELLED
}

// --- PHASE 7 FIXED ASSETS & DEPRECIATION ENUMS ---

enum DepreciationMethod {
  STRAIGHT_LINE
  DECLINING_BALANCE
  NONE
}

enum AssetStatus {
  DRAFT
  ACTIVE
  FULLY_DEPRECIATED
  DISPOSED
  RETIRED
  IMPAIRED
}

enum DepreciationScheduleStatus {
  SCHEDULED
  POSTED
  REVERSED
}

enum DepreciationRunStatus {
  DRAFT
  CALCULATED
  POSTED
  REVERSED
}

enum DisposalType {
  SALE
  SCRAP
  RETIREMENT
  LOSS
}

enum DisposalStatus {
  DRAFT
  POSTED
  REVERSED
}

// --- PHASE 8 INDONESIAN TAX ENGINE ENUMS ---

enum TaxType {
  VAT
  PPH23
  PPH4_2
  PPH21
  PPH26
  PPNBM
  OTHER
}

enum TaxDirection {
  OUTPUT
  INPUT
  WITHHOLDING_PAYABLE
  WITHHOLDING_RECEIVABLE
}

enum TaxCalculationMethod {
  PERCENT_OF_BASE
  RATE_TIMES_DPP_FACTOR
  FIXED_AMOUNT
  SPECIAL_FORMULA
}

enum TaxRoundingMethod {
  ROUND_HALF_UP
  ROUND_DOWN
  ROUND_UP
}

enum TaxTransactionStatus {
  DRAFT
  POSTED
  ADJUSTED
  REVERSED
  REPORTED
}

enum TaxPeriodStatus {
  OPEN
  PREPARED
  FILED
  PARTIALLY_PAID
  PAID
  CLOSED
  REOPENED
}

enum TaxDocumentType {
  FAKTUR_PAJAK
  BUKTI_POTONG
  SSP
  OTHER
}

enum TaxDocumentStatus {
  DRAFT
  READY
  ISSUED
  RECEIVED
  VALIDATED
  REPORTED
  CANCELLED
  REPLACED
}

enum TaxPaymentStatus {
  DRAFT
  POSTED
  REVERSED
}

enum WithholdingEvidenceStatus {
  PENDING_DOCUMENT
  DOCUMENTED
  REPORTED
}

enum TaxSourceType {
  SALES_INVOICE
  VENDOR_BILL
  PAYMENT
  ASSET_CAPITALIZATION
  GOODS_RECEIPT
  MIGRATED_LEGACY
  MANUAL
  OTHER
}

model Organization {
  id           String               @id @default(uuid())
  name         String               @db.VarChar(255)
  slug         String               @unique @db.VarChar(100)
  baseCurrency String               @default("IDR") @map("base_currency") @db.VarChar(10)
  timezone     String               @default("Asia/Jakarta") @db.VarChar(100)
  createdAt    DateTime             @default(now()) @map("created_at")
  updatedAt    DateTime             @updatedAt @map("updated_at")

  members               OrganizationMember[]
  entities              Entity[]
  auditLogs             AuditLog[]
  accounts              Account[]
  journalEntries        JournalEntry[]
  accountingSettings    AccountingSettings[]
  customers             Customer[]
  salesInvoices         SalesInvoice[]
  vendors               Vendor[]
  purchaseOrders        PurchaseOrder[]
  vendorBills           VendorBill[]
  cashBankAccounts      CashBankAccount[]
  payments              Payment[]
  bankStatementImports  BankStatementImport[]
  bankReconciliations   BankReconciliation[]
  unitOfMeasures        UnitOfMeasure[]
  inventoryCategories   InventoryCategory[]
  warehouses            Warehouse[]
  inventoryItems        InventoryItem[]
  stockMovements        StockMovement[]
  valuationLayers       InventoryValuationLayer[]
  goodsReceipts         GoodsReceipt[]
  deliveries            Delivery[]
  stockTransfers        StockTransfer[]
  stockAdjustments      StockAdjustment[]
  fixedAssetCategories  FixedAssetCategory[]
  fixedAssets           FixedAsset[]
  depreciationRuns      DepreciationRun[]
  assetDisposals        AssetDisposal[]
  taxCodes              TaxCode[]
  taxPeriods            TaxPeriod[]
  taxTransactions       TaxTransaction[]
  taxDocuments          TaxDocument[]
  taxPayments           TaxPayment[]
  budgets               Budget[]
  projects              Project[]
  payrollEmployees      PayrollEmployee[]
  payrollRuns           PayrollRun[]
  subscription          Subscription?

  @@map("organizations")
}

model User {
  id           String               @id @default(uuid())
  email        String               @unique @db.VarChar(255)
  passwordHash String               @map("password_hash") @db.VarChar(255)
  fullName     String               @map("full_name") @db.VarChar(255)
  avatarUrl    String?              @map("avatar_url") @db.Text
  phone        String?              @db.VarChar(50)
  isActive     Boolean              @default(true) @map("is_active")
  createdAt    DateTime             @default(now()) @map("created_at")
  updatedAt    DateTime             @updatedAt @map("updated_at")

  memberships           OrganizationMember[]
  sessions              Session[]
  auditLogs             AuditLog[]
  userSettings          UserSettings?
  postedJournals        JournalEntry[]        @relation("PostedByRelation")
  createdInvoices       SalesInvoice[]        @relation("CreatedByRelation")
  postedInvoices        SalesInvoice[]        @relation("PostedByInvoiceRelation")
  createdOrders         PurchaseOrder[]       @relation("CreatedByOrderRelation")
  approvedOrders        PurchaseOrder[]       @relation("ApprovedByOrderRelation")
  createdBills          VendorBill[]          @relation("CreatedByBillRelation")
  postedBills           VendorBill[]          @relation("PostedByBillRelation")
  createdPayments       Payment[]             @relation("CreatedByPaymentRelation")
  postedPayments        Payment[]             @relation("PostedByPaymentRelation")
  importedStatements    BankStatementImport[] @relation("ImportedByRelation")
  completedReconciles   BankReconciliation[]  @relation("CompletedByReconciliationRelation")
  createdReceipts       GoodsReceipt[]        @relation("CreatedByReceiptRelation")
  postedReceipts        GoodsReceipt[]        @relation("PostedByReceiptRelation")
  createdDeliveries     Delivery[]            @relation("CreatedByDeliveryRelation")
  postedDeliveries      Delivery[]            @relation("PostedByDeliveryRelation")
  createdMovements      StockMovement[]       @relation("CreatedByMovementRelation")
  postedMovements       StockMovement[]       @relation("PostedByMovementRelation")
  createdTransfers      StockTransfer[]       @relation("CreatedByTransferRelation")
  postedTransfers       StockTransfer[]       @relation("PostedByTransferRelation")
  createdAdjustments    StockAdjustment[]     @relation("CreatedByAdjustmentRelation")
  postedAdjustments     StockAdjustment[]     @relation("PostedByAdjustmentRelation")
  createdAssets         FixedAsset[]          @relation("CreatedByAssetRelation")
  capitalizedAssets     FixedAsset[]          @relation("CapitalizedByAssetRelation")
  createdDeprecRuns     DepreciationRun[]     @relation("CreatedByDeprecRunRelation")
  postedDeprecRuns      DepreciationRun[]     @relation("PostedByDeprecRunRelation")
  createdMovementsFA    AssetMovement[]       @relation("CreatedByAssetMovementRelation")
  createdDisposals      AssetDisposal[]       @relation("CreatedByDisposalRelation")
  postedDisposals       AssetDisposal[]       @relation("PostedByDisposalRelation")
  createdTaxPayments    TaxPayment[]          @relation("CreatedByTaxPaymentRelation")
  postedTaxPayments     TaxPayment[]          @relation("PostedByTaxPaymentRelation")
  filedTaxPeriods       TaxPeriod[]           @relation("FiledByTaxPeriodRelation")
  createdBudgets        Budget[]              @relation("CreatedByBudgetRelation")
  createdProjects       Project[]             @relation("CreatedByProjectRelation")
  createdPayrollRuns    PayrollRun[]          @relation("CreatedByPayrollRunRelation")

  @@map("users")
}

model OrganizationMember {
  id             String       @id @default(uuid())
  organizationId String       @map("organization_id")
  userId         String       @map("user_id")
  role           Role         @default(VIEWER)
  createdAt      DateTime     @default(now()) @map("created_at")
  updatedAt      DateTime     @updatedAt @map("updated_at")

  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([organizationId, userId])
  @@index([organizationId])
  @@index([userId])
  @@map("organization_members")
}

model Entity {
  id             String               @id @default(uuid())
  organizationId String               @map("organization_id")
  name           String               @db.VarChar(255)
  code           String               @db.VarChar(50)
  legalName      String?              @map("legal_name") @db.VarChar(255)
  baseCurrency   String               @default("IDR") @map("base_currency") @db.VarChar(10)
  country        String               @default("ID") @db.VarChar(10)
  timezone       String               @default("Asia/Jakarta") @db.VarChar(100)
  isActive       Boolean              @default(true) @map("is_active")
  createdAt      DateTime             @default(now()) @map("created_at")
  updatedAt      DateTime             @updatedAt @map("updated_at")

  organization          Organization          @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  accounts              Account[]
  journalEntries        JournalEntry[]
  accountingSettings    AccountingSettings[]
  customers             Customer[]
  salesInvoices         SalesInvoice[]
  vendors               Vendor[]
  purchaseOrders        PurchaseOrder[]
  vendorBills           VendorBill[]
  cashBankAccounts      CashBankAccount[]
  payments              Payment[]
  bankStatementImports  BankStatementImport[]
  bankReconciliations   BankReconciliation[]
  inventoryCategories   InventoryCategory[]
  warehouses            Warehouse[]
  inventoryItems        InventoryItem[]
  stockMovements        StockMovement[]
  valuationLayers       InventoryValuationLayer[]
  goodsReceipts         GoodsReceipt[]
  deliveries            Delivery[]
  stockTransfers        StockTransfer[]
  stockAdjustments      StockAdjustment[]
  fixedAssetCategories  FixedAssetCategory[]
  fixedAssets           FixedAsset[]
  depreciationRuns      DepreciationRun[]
  assetDisposals        AssetDisposal[]
  taxPeriods            TaxPeriod[]
  taxTransactions       TaxTransaction[]
  taxDocuments          TaxDocument[]
  taxPayments           TaxPayment[]
  budgets               Budget[]
  projects              Project[]
  payrollEmployees      PayrollEmployee[]
  payrollRuns           PayrollRun[]

  @@unique([organizationId, code])
  @@index([organizationId])
  @@map("entities")
}

model Session {
  id        String   @id @default(uuid())
  userId    String   @map("user_id")
  tokenHash String   @unique @map("token_hash") @db.VarChar(255)
  expiresAt DateTime @map("expires_at")
  createdAt DateTime @default(now()) @map("created_at")

  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([tokenHash])
  @@map("sessions")
}

model AuditLog {
  id             String        @id @default(uuid())
  organizationId String        @map("organization_id")
  userId         String?       @map("user_id")
  action         String        @db.VarChar(100)
  resourceType   String        @map("resource_type") @db.VarChar(100)
  resourceId     String?       @map("resource_id") @db.VarChar(100)
  metadata       Json?         @db.JsonB
  ipAddress      String?       @map("ip_address") @db.VarChar(50)
  userAgent      String?       @map("user_agent") @db.Text
  createdAt      DateTime      @default(now()) @map("created_at")

  organization   Organization  @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user           User?         @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([organizationId])
  @@index([userId])
  @@index([action])
  @@map("audit_logs")
}

// --- PHASE 2 CORE ACCOUNTING ENGINE MODELS ---

model Account {
  id             String         @id @default(uuid())
  organizationId String         @map("organization_id")
  entityId       String         @map("entity_id")
  code           String         @db.VarChar(50)
  name           String         @db.VarChar(255)
  type           AccountType
  subtype        AccountSubtype
  normalBalance  NormalBalance  @default(DEBIT) @map("normal_balance")
  description    String?        @db.Text
  parentId       String?        @map("parent_id")
  isActive       Boolean        @default(true) @map("is_active")
  isSystem       Boolean        @default(false) @map("is_system")
  currency       String         @default("IDR") @db.VarChar(10)
  createdAt      DateTime       @default(now()) @map("created_at")
  updatedAt      DateTime       @updatedAt @map("updated_at")

  organization          Organization          @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  entity                Entity                @relation(fields: [entityId], references: [id], onDelete: Cascade)
  parent                Account?              @relation("AccountHierarchy", fields: [parentId], references: [id], onDelete: Restrict)
  children              Account[]             @relation("AccountHierarchy")
  journalLines          JournalLine[]

  arSettings            AccountingSettings[]  @relation("ARAccountRelation")
  apSettings            AccountingSettings[]  @relation("APAccountRelation")
  defaultRevenueSettings AccountingSettings[] @relation("DefaultRevenueAccountRelation")
  defaultExpenseSettings AccountingSettings[] @relation("DefaultExpenseAccountRelation")
  outputTaxSettings     AccountingSettings[]  @relation("OutputTaxAccountRelation")
  inputTaxSettings      AccountingSettings[]  @relation("InputTaxAccountRelation")
  retainedEarningsSettings AccountingSettings[] @relation("RetainedEarningsAccountRelation")
  customerAdvanceSettings AccountingSettings[] @relation("CustomerAdvanceAccountRelation")
  vendorAdvanceSettings   AccountingSettings[] @relation("VendorAdvanceAccountRelation")
  bankFeeSettings       AccountingSettings[]  @relation("BankFeeAccountRelation")
  bankInterestSettings  AccountingSettings[]  @relation("BankInterestAccountRelation")
  bankSuspenseSettings  AccountingSettings[]  @relation("BankSuspenseAccountRelation")
  inventorySettings     AccountingSettings[]  @relation("InventoryAccountRelation")
  cogsSettings          AccountingSettings[]  @relation("COGSAccountRelation")
  grniSettings          AccountingSettings[]  @relation("GRNIAccountRelation")
  inventoryAdjustmentSettings AccountingSettings[] @relation("InventoryAdjustmentAccountRelation")
  inventoryAdjustmentGainSettings AccountingSettings[] @relation("InventoryAdjustmentGainAccountRelation")

  purchaseOrderLines    PurchaseOrderLine[]   @relation("LinePOExpenseAccountRelation")
  vendorBillLines       VendorBillLine[]      @relation("LineBillExpenseAccountRelation")
  salesInvoiceLines     SalesInvoiceLine[]    @relation("LineSalesRevenueAccountRelation")
  cashBankAccounts      CashBankAccount[]     @relation("CashBankAccountCOARelation")
  inventoryItemsAsInventory InventoryItem[]   @relation("ItemInventoryAccountRelation")
  inventoryItemsAsCOGS      InventoryItem[]   @relation("ItemCOGSAccountRelation")
  inventoryItemsAsSales     InventoryItem[]   @relation("ItemSalesAccountRelation")
  inventoryItemsAsPurchase  InventoryItem[]   @relation("ItemPurchaseAccountRelation")

  categoriesAsFixedAsset            FixedAssetCategory[] @relation("CategoryFixedAssetAccountRelation")
  categoriesAsAccumulatedDeprec     FixedAssetCategory[] @relation("CategoryAccumulatedDeprecAccountRelation")
  categoriesAsDeprecExpense         FixedAssetCategory[] @relation("CategoryDeprecExpenseAccountRelation")
  categoriesAsGainOnDisposal        FixedAssetCategory[] @relation("CategoryGainOnDisposalAccountRelation")
  categoriesAsLossOnDisposal        FixedAssetCategory[] @relation("CategoryLossOnDisposalAccountRelation")

  // Phase 8 - Tax Engine
  vatPayableSettings        AccountingSettings[]  @relation("VATPayableAccountRelation")
  pph23PayableSettings      AccountingSettings[]  @relation("PPh23PayableAccountRelation")
  pph23ReceivableSettings   AccountingSettings[]  @relation("PPh23ReceivableAccountRelation")
  pph4_2PayableSettings     AccountingSettings[]  @relation("PPh4_2PayableAccountRelation")

  // Phase 9 - Budgeting
  budgets                   Budget[]

  @@unique([entityId, code])
  @@index([organizationId])
  @@index([entityId])
  @@index([type])
  @@index([code])
  @@map("accounts")
}

model JournalEntry {
  id             String             @id @default(uuid())
  organizationId String             @map("organization_id")
  entityId       String             @map("entity_id")
  entryNumber    String             @map("entry_number") @db.VarChar(100)
  entryDate      DateTime           @map("entry_date") @db.Date
  description    String             @db.Text
  reference      String?            @db.VarChar(255)
  status         JournalEntryStatus @default(DRAFT)
  currency       String             @default("IDR") @db.VarChar(10)
  exchangeRate   Decimal            @default(1.0) @map("exchange_rate") @db.Decimal(12, 6)
  createdById    String?            @map("created_by_id")
  postedById     String?            @map("posted_by_id")
  postedAt       DateTime?          @map("posted_at")
  createdAt      DateTime           @default(now()) @map("created_at")
  updatedAt      DateTime           @updatedAt @map("updated_at")

  organization           Organization             @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  entity                 Entity                   @relation(fields: [entityId], references: [id], onDelete: Cascade)
  postedBy               User?                    @relation("PostedByRelation", fields: [postedById], references: [id], onDelete: SetNull)
  lines                  JournalLine[]
  salesInvoices          SalesInvoice[]
  vendorBills            VendorBill[]
  payments               Payment[]
  reconciliationMatches  BankReconciliationMatch[]
  goodsReceipts          GoodsReceipt[]
  deliveries             Delivery[]
  stockMovements         StockMovement[]
  stockAdjustments       StockAdjustment[]
  fixedAssets            FixedAsset[]
  depreciationRuns       DepreciationRun[]
  depreciationSchedules  AssetDepreciationSchedule[]
  assetDisposals         AssetDisposal[]
  assetImpairments       AssetImpairment[]
  taxTransactions        TaxTransaction[]
  taxPayments            TaxPayment[]

  @@unique([entityId, entryNumber])
  @@index([organizationId])
  @@index([entityId])
  @@index([entryDate])
  @@index([status])
  @@map("journal_entries")
}

model JournalLine {
  id             String       @id @default(uuid())
  journalEntryId String       @map("journal_entry_id")
  accountId      String       @map("account_id")
  description    String?      @db.Text
  debit          Decimal      @default(0.0000) @db.Decimal(18, 4)
  credit         Decimal      @default(0.0000) @db.Decimal(18, 4)
  currency       String       @default("IDR") @db.VarChar(10)
  exchangeRate   Decimal      @default(1.0) @map("exchange_rate") @db.Decimal(12, 6)
  createdAt      DateTime     @default(now()) @map("created_at")

  journalEntry   JournalEntry @relation(fields: [journalEntryId], references: [id], onDelete: Cascade)
  account        Account      @relation(fields: [accountId], references: [id], onDelete: Restrict)

  @@index([journalEntryId])
  @@index([accountId])
  @@map("journal_lines")
}

// --- PHASE 3, 4 & 5 OPERATIONAL SUB-LEDGER MODELS ---

model AccountingSettings {
  id                        String       @id @default(uuid())
  organizationId            String       @map("organization_id")
  entityId                  String       @unique @map("entity_id")
  arAccountId               String       @map("ar_account_id")
  defaultRevenueAccountId   String       @map("default_revenue_account_id")
  outputTaxAccountId        String       @map("output_tax_account_id")
  apAccountId               String?      @map("ap_account_id")
  inputTaxAccountId         String?      @map("input_tax_account_id")
  defaultExpenseAccountId   String?      @map("default_expense_account_id")
  retainedEarningsAccountId String?      @map("retained_earnings_account_id")
  customerAdvanceAccountId  String?      @map("customer_advance_account_id")
  vendorAdvanceAccountId    String?      @map("vendor_advance_account_id")
  bankFeeExpenseAccountId   String?      @map("bank_fee_expense_account_id")
  bankInterestIncomeAccountId String?    @map("bank_interest_income_account_id")
  bankSuspenseAccountId     String?      @map("bank_suspense_account_id")
  inventoryAccountId        String?      @map("inventory_account_id")
  cogsAccountId             String?      @map("cogs_account_id")
  grniAccountId             String?      @map("grni_account_id")
  inventoryAdjustmentAccountId String?   @map("inventory_adjustment_account_id")
  inventoryAdjustmentGainAccountId String? @map("inventory_adjustment_gain_account_id")
  // Phase 8 - Tax Engine accounts
  vatPayableAccountId           String?  @map("vat_payable_account_id")
  pph23PayableAccountId         String?  @map("pph23_payable_account_id")
  pph23ReceivableAccountId      String?  @map("pph23_receivable_account_id")
  pph4_2PayableAccountId        String?  @map("pph4_2_payable_account_id")
  createdAt                 DateTime     @default(now()) @map("created_at")
  updatedAt                 DateTime     @updatedAt @map("updated_at")

  organization              Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  entity                    Entity       @relation(fields: [entityId], references: [id], onDelete: Cascade)
  arAccount                 Account      @relation("ARAccountRelation", fields: [arAccountId], references: [id], onDelete: Restrict)
  defaultRevenueAccount     Account      @relation("DefaultRevenueAccountRelation", fields: [defaultRevenueAccountId], references: [id], onDelete: Restrict)
  outputTaxAccount          Account      @relation("OutputTaxAccountRelation", fields: [outputTaxAccountId], references: [id], onDelete: Restrict)
  apAccount                 Account?     @relation("APAccountRelation", fields: [apAccountId], references: [id], onDelete: Restrict)
  inputTaxAccount           Account?     @relation("InputTaxAccountRelation", fields: [inputTaxAccountId], references: [id], onDelete: Restrict)
  defaultExpenseAccount     Account?     @relation("DefaultExpenseAccountRelation", fields: [defaultExpenseAccountId], references: [id], onDelete: Restrict)
  retainedEarningsAccount   Account?     @relation("RetainedEarningsAccountRelation", fields: [retainedEarningsAccountId], references: [id], onDelete: Restrict)
  customerAdvanceAccount    Account?     @relation("CustomerAdvanceAccountRelation", fields: [customerAdvanceAccountId], references: [id], onDelete: Restrict)
  vendorAdvanceAccount      Account?     @relation("VendorAdvanceAccountRelation", fields: [vendorAdvanceAccountId], references: [id], onDelete: Restrict)
  bankFeeExpenseAccount     Account?     @relation("BankFeeAccountRelation", fields: [bankFeeExpenseAccountId], references: [id], onDelete: Restrict)
  bankInterestIncomeAccount Account?     @relation("BankInterestAccountRelation", fields: [bankInterestIncomeAccountId], references: [id], onDelete: Restrict)
  bankSuspenseAccount       Account?     @relation("BankSuspenseAccountRelation", fields: [bankSuspenseAccountId], references: [id], onDelete: Restrict)
  inventoryAccount          Account?     @relation("InventoryAccountRelation", fields: [inventoryAccountId], references: [id], onDelete: Restrict)
