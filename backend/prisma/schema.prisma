  @@index([stockAdjustmentId])
  @@index([itemId])
  @@map("stock_adjustment_lines")
}

// --- PHASE 7 FIXED ASSETS & DEPRECIATION MODELS ---

model FixedAssetCategory {
  id                               String             @id @default(uuid())
  organizationId                   String             @map("organization_id")
  entityId                         String             @map("entity_id")
  code                             String             @db.VarChar(50)
  name                             String             @db.VarChar(255)
  description                      String?            @db.Text
  fixedAssetAccountId              String             @map("fixed_asset_account_id")
  accumulatedDepreciationAccountId String             @map("accumulated_depreciation_account_id")
  depreciationExpenseAccountId     String             @map("depreciation_expense_account_id")
  gainOnDisposalAccountId          String             @map("gain_on_disposal_account_id")
  lossOnDisposalAccountId          String             @map("loss_on_disposal_account_id")
  defaultUsefulLifeMonths          Int?               @map("default_useful_life_months")
  defaultDepreciationMethod        DepreciationMethod @default(STRAIGHT_LINE) @map("default_depreciation_method")
  defaultResidualValuePercent      Decimal            @default(0.0000) @map("default_residual_value_percent") @db.Decimal(6, 4)
  isActive                         Boolean            @default(true) @map("is_active")
  createdAt                        DateTime           @default(now()) @map("created_at")
  updatedAt                        DateTime           @updatedAt @map("updated_at")

  organization                     Organization       @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  entity                           Entity             @relation(fields: [entityId], references: [id], onDelete: Cascade)
  fixedAssetAccount                Account            @relation("CategoryFixedAssetAccountRelation", fields: [fixedAssetAccountId], references: [id], onDelete: Restrict)
  accumulatedDepreciationAccount   Account            @relation("CategoryAccumulatedDeprecAccountRelation", fields: [accumulatedDepreciationAccountId], references: [id], onDelete: Restrict)
  depreciationExpenseAccount       Account            @relation("CategoryDeprecExpenseAccountRelation", fields: [depreciationExpenseAccountId], references: [id], onDelete: Restrict)
  gainOnDisposalAccount            Account            @relation("CategoryGainOnDisposalAccountRelation", fields: [gainOnDisposalAccountId], references: [id], onDelete: Restrict)
  lossOnDisposalAccount            Account            @relation("CategoryLossOnDisposalAccountRelation", fields: [lossOnDisposalAccountId], references: [id], onDelete: Restrict)

  assets                           FixedAsset[]
  vendorBillLines                  VendorBillLine[]

  @@unique([entityId, code])
  @@index([organizationId])
  @@index([entityId])
  @@map("fixed_asset_categories")
}

model FixedAsset {
  id                      String                     @id @default(uuid())
  organizationId          String                     @map("organization_id")
  entityId                String                     @map("entity_id")
  assetNumber             String                     @map("asset_number") @db.VarChar(100)
  categoryId              String                     @map("category_id")
  name                    String                     @db.VarChar(255)
  description             String?                    @db.Text
  serialNumber            String?                    @map("serial_number") @db.VarChar(100)
  acquisitionDate         DateTime                   @map("acquisition_date") @db.Date
  capitalizationDate      DateTime?                  @map("capitalization_date") @db.Date
  depreciationStartDate   DateTime?                  @map("depreciation_start_date") @db.Date
  acquisitionCost         Decimal                    @map("acquisition_cost") @db.Decimal(18, 4)
  residualValue           Decimal                    @default(0.0000) @map("residual_value") @db.Decimal(18, 4)
  depreciableAmount       Decimal                    @default(0.0000) @map("depreciable_amount") @db.Decimal(18, 4)
  usefulLifeMonths        Int?                       @map("useful_life_months")
  depreciationMethod      DepreciationMethod         @default(STRAIGHT_LINE) @map("depreciation_method")
  accumulatedDepreciation Decimal                    @default(0.0000) @map("accumulated_depreciation") @db.Decimal(18, 4)
  netBookValue            Decimal                    @map("net_book_value") @db.Decimal(18, 4)
  status                  AssetStatus                @default(DRAFT)
  vendorId                String?                    @map("vendor_id")
  vendorBillId            String?                    @map("vendor_bill_id")
  vendorBillLineId        String?                    @map("vendor_bill_line_id")
  purchaseOrderId         String?                    @map("purchase_order_id")
  location                String?                    @db.VarChar(255)
  department              String?                    @db.VarChar(100)
  custodian               String?                    @db.VarChar(255)
  reference               String?                    @db.VarChar(255)
  journalEntryId          String?                    @map("journal_entry_id")
  createdById             String?                    @map("created_by_id")
  capitalizedById         String?                    @map("capitalized_by_id")
  capitalizedAt           DateTime?                  @map("capitalized_at")
  disposedAt              DateTime?                  @map("disposed_at")
  createdAt               DateTime                   @default(now()) @map("created_at")
  updatedAt               DateTime                   @updatedAt @map("updated_at")

  organization            Organization               @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  entity                  Entity                     @relation(fields: [entityId], references: [id], onDelete: Cascade)
  category                FixedAssetCategory         @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  vendor                  Vendor?                    @relation(fields: [vendorId], references: [id], onDelete: SetNull)
  vendorBill              VendorBill?                @relation(fields: [vendorBillId], references: [id], onDelete: SetNull)
  vendorBillLine          VendorBillLine?            @relation(fields: [vendorBillLineId], references: [id], onDelete: SetNull)
  purchaseOrder           PurchaseOrder?             @relation(fields: [purchaseOrderId], references: [id], onDelete: SetNull)
  journalEntry            JournalEntry?              @relation(fields: [journalEntryId], references: [id], onDelete: SetNull)
  createdBy               User?                      @relation("CreatedByAssetRelation", fields: [createdById], references: [id], onDelete: SetNull)
  capitalizedBy           User?                      @relation("CapitalizedByAssetRelation", fields: [capitalizedById], references: [id], onDelete: SetNull)

  schedules               AssetDepreciationSchedule[]
  movements               AssetMovement[]
  disposals               AssetDisposal[]
  impairments             AssetImpairment[]

  @@unique([entityId, assetNumber])
  @@index([organizationId])
  @@index([entityId])
  @@index([assetNumber])
  @@index([categoryId])
  @@index([status])
  @@index([capitalizationDate])
  @@map("fixed_assets")
}

model AssetDepreciationSchedule {
  id                      String                     @id @default(uuid())
  assetId                 String                     @map("asset_id")
  periodYear              Int                        @map("period_year")
  periodMonth             Int                        @map("period_month")
  depreciationDate        DateTime                   @map("depreciation_date") @db.Date
  openingBookValue        Decimal                    @map("opening_book_value") @db.Decimal(18, 4)
  depreciationAmount      Decimal                    @map("depreciation_amount") @db.Decimal(18, 4)
  accumulatedDepreciation Decimal                    @map("accumulated_depreciation") @db.Decimal(18, 4)
  closingBookValue        Decimal                    @map("closing_book_value") @db.Decimal(18, 4)
  status                  DepreciationScheduleStatus @default(SCHEDULED)
  depreciationRunId       String?                    @map("depreciation_run_id")
  journalEntryId          String?                    @map("journal_entry_id")
  postedAt                DateTime?                  @map("posted_at")
  createdAt               DateTime                   @default(now()) @map("created_at")

  asset                   FixedAsset                 @relation(fields: [assetId], references: [id], onDelete: Cascade)
  depreciationRun         DepreciationRun?           @relation(fields: [depreciationRunId], references: [id], onDelete: SetNull)
  journalEntry            JournalEntry?              @relation(fields: [journalEntryId], references: [id], onDelete: SetNull)

  @@unique([assetId, periodYear, periodMonth])
  @@index([assetId])
  @@index([periodYear, periodMonth])
  @@index([status])
  @@map("asset_depreciation_schedules")
}

model DepreciationRun {
  id                String                      @id @default(uuid())
  organizationId    String                      @map("organization_id")
  entityId          String                      @map("entity_id")
  periodYear        Int                         @map("period_year")
  periodMonth       Int                         @map("period_month")
  runNumber         String                      @map("run_number") @db.VarChar(100)
  status            DepreciationRunStatus       @default(DRAFT)
  totalDepreciation Decimal                     @default(0.0000) @map("total_depreciation") @db.Decimal(18, 4)
  journalEntryId    String?                     @map("journal_entry_id")
  createdById       String?                     @map("created_by_id")
  postedById        String?                     @map("posted_by_id")
  postedAt          DateTime?                   @map("posted_at")
  createdAt         DateTime                    @default(now()) @map("created_at")
  updatedAt         DateTime                    @updatedAt @map("updated_at")

  organization      Organization                @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  entity            Entity                      @relation(fields: [entityId], references: [id], onDelete: Cascade)
  journalEntry      JournalEntry?               @relation(fields: [journalEntryId], references: [id], onDelete: SetNull)
  createdBy         User?                       @relation("CreatedByDeprecRunRelation", fields: [createdById], references: [id], onDelete: SetNull)
  postedBy          User?                       @relation("PostedByDeprecRunRelation", fields: [postedById], references: [id], onDelete: SetNull)

  schedules         AssetDepreciationSchedule[]

  @@unique([entityId, periodYear, periodMonth])
  @@unique([entityId, runNumber])
  @@index([organizationId])
  @@index([entityId])
  @@index([periodYear, periodMonth])
  @@index([status])
  @@map("depreciation_runs")
}

model AssetMovement {
  id            String     @id @default(uuid())
  assetId       String     @map("asset_id")
  fromLocation  String?    @map("from_location") @db.VarChar(255)
  toLocation    String     @map("to_location") @db.VarChar(255)
  fromCustodian String?    @map("from_custodian") @db.VarChar(255)
  toCustodian   String?    @map("to_custodian") @db.VarChar(255)
  movementDate  DateTime   @map("movement_date") @db.Date
  reason        String?    @db.Text
  createdById   String?    @map("created_by_id")
  createdAt     DateTime   @default(now()) @map("created_at")

  asset         FixedAsset @relation(fields: [assetId], references: [id], onDelete: Cascade)
  createdBy     User?      @relation("CreatedByAssetMovementRelation", fields: [createdById], references: [id], onDelete: SetNull)

  @@index([assetId])
  @@index([movementDate])
  @@map("asset_movements")
}

model AssetDisposal {
  id                String          @id @default(uuid())
  organizationId    String          @map("organization_id")
  entityId          String          @map("entity_id")
  assetId           String          @map("asset_id")
  disposalDate      DateTime        @map("disposal_date") @db.Date
  disposalType      DisposalType    @map("disposal_type")
  proceeds          Decimal         @default(0.0000) @db.Decimal(18, 4)
  buyerId           String?         @map("buyer_id")
